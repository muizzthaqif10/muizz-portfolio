# Optional: GitHub username to dynamically fetch public repositories on the /projects page.
# If unset, the site falls back to the static project data in src/data/projects.ts
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional: contact form endpoint (Formspree, Resend function, etc.)
# If unset, the contact form falls back to a mailto: link.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
